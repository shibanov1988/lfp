# Скопируйте этот файл в Update-1C.local.ps1 (рядом, в этой же папке) и заполните
# под свою машину. Update-1C.local.ps1 добавлен в .gitignore и не коммитится —
# в нём может быть пароль от базы.

# Путь к 1cv8.exe вашей установленной версии платформы 1С.
# Посмотреть версию: C:\Program Files\1cv8\<версия>\bin\1cv8.exe
$DesignerExe = "C:\Program Files\1cv8\8.3.27.1508\bin\1cv8.exe"

# Строка подключения к базе — ОДНИМ токеном, без пробела после /F или /S.
# Файловая база:
$ConnectionString = '/F"C:\Bases\LFP"'
# Серверная база (используйте вместо строки выше):
# $ConnectionString = '/SMyServer\LFP'

# Пользователь ИБ. Если в базе не настроена аутентификация 1С (нет списка
# пользователей или используется Windows-аутентификация) — оставьте пустыми,
# строки /N и /P тогда просто не добавляются в командную строку.
$IbUser = ""
$IbPassword = ""
