// Возвращает пользователя, от имени которого сейчас ведётся личный финансовый план.
// Пока конфигурация однопользовательская, источник — константа ТекущийПользователь.
Функция ТекущийПользователь() Экспорт
	Возврат Константы.ТекущийПользователь.Получить();
КонецФункции

// Возвращает дату дожития текущего пользователя как верхний ограничитель
// диалога расписания (чтобы разовое/повторяющееся правило не предлагалось
// длить бесконечно), или Неопределено, если пользователь/дата не заданы.
// Для горизонта генерации документов и материализации расписания НЕ
// используется — см. ГоризонтГенерацииПоУмолчанию.
Функция ГраницаПланированияПоУмолчанию() Экспорт
	Пользователь = ТекущийПользователь();
	Если ЗначениеЗаполнено(Пользователь) И ЗначениеЗаполнено(Пользователь.ДатаДожития) Тогда
		Возврат Пользователь.ДатаДожития;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Горизонт генерации/материализации плановых документов по умолчанию — до
// конца следующего года. Дата дожития для этого не подходит: суммы
// регулярных правил (подарки на ДР, аренда и т.п.) не сохраняют смысл на
// десятилетия вперёд, а заглядывать дальше чем на 1-2 года незачем — при
// следующем сохранении правила документы пересоздадутся на актуальный
// горизонт заново.
Функция ГоризонтГенерацииПоУмолчанию() Экспорт
	Возврат КонецГода(ДобавитьМесяц(ТекущаяДата(), 12));
КонецФункции

// Возвращает дату ближайшего прошедшего (или текущего) дня рождения на момент НаДату.
Функция ПоследнийДеньРождения(ДатаРождения, НаДату) Экспорт
	РезультатДата = Дата(Год(НаДату), Месяц(ДатаРождения), День(ДатаРождения));
	Если РезультатДата > НаДату Тогда
		РезультатДата = ДобавитьМесяц(РезультатДата, -12);
	КонецЕсли;
	Возврат РезультатДата;
КонецФункции

// Возвращает курс валюты к рублю на дату: сколько рублей за Кратность единиц валюты.
// Для рубля всегда 1 — в РегистрСведений.КурсыВалют записи для рубля не нужны.
// Возвращает 0, если курс на дату не найден (валюта не рубль и записей ещё нет).
Функция КурсКРублю(Валюта, Дата) Экспорт

	Если Валюта.Код = "RUB" Тогда
		Возврат 1;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Валюта", Валюта);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КурсыВалютСрезПоследних.Курс КАК Курс,
	|	КурсыВалютСрезПоследних.Кратность КАК Кратность
	|ИЗ
	|	РегистрСведений.КурсыВалют.СрезПоследних(&Дата, Валюта = &Валюта) КАК КурсыВалютСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();

	Если НЕ Выборка.Следующий() ИЛИ Выборка.Кратность = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Выборка.Курс / Выборка.Кратность;

КонецФункции

// Переводит Сумма из Валюта в текущую основную валюту (Константа.ОсновнаяВалюта) на дату Дата,
// через рубль как опорную точку. Возвращает 0, если курс одной из валют на дату не найден.
Функция КонвертироватьВОсновнуюВалюту(Сумма, Валюта, Дата) Экспорт

	ОсновнаяВалюта = Константы.ОсновнаяВалюта.Получить();
	Если НЕ ЗначениеЗаполнено(ОсновнаяВалюта) ИЛИ Валюта = ОсновнаяВалюта Тогда
		Возврат Сумма;
	КонецЕсли;

	КурсИсходной = КурсКРублю(Валюта, Дата);
	КурсОсновной = КурсКРублю(ОсновнаяВалюта, Дата);
	Если КурсОсновной = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Сумма * КурсИсходной / КурсОсновной;

КонецФункции

// Создаёт недостающие документы ПлановаяОперация по активным правилам
// (Справочник.ПлановыеПравила) на период до ГраницаГенерации включительно.
// Источник дат — табличная часть ПлановыеПравила.Расписание, которую
// заполняет форма элемента правила (кнопка "Настроить расписание") исходя
// из штатного диалога расписания; здесь только читаем готовые даты.
// Уже созданные ранее (по паре Источник+Дата) документы не дублирует —
// функцию можно безопасно вызывать повторно, просто сдвигая границу вперёд.
// Возвращает количество созданных документов.
Функция СгенерироватьПлановыеОперации(ГраницаГенерации) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ГраницаГенерации", ГраницаГенерации);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Расписание.Ссылка КАК Правило,
	|	Расписание.Ссылка.СтатьяДДС КАК СтатьяДДС,
	|	Расписание.Ссылка.Получатель КАК Получатель,
	|	Расписание.Ссылка.Валюта КАК Валюта,
	|	Расписание.Ссылка.Сумма КАК Сумма,
	|	Расписание.Дата КАК Дата
	|ИЗ
	|	Справочник.ПлановыеПравила.Расписание КАК Расписание
	|ГДЕ
	|	Расписание.Ссылка.Активно = ИСТИНА
	|	И Расписание.Дата <= &ГраницаГенерации";
	Выборка = Запрос.Выполнить().Выбрать();

	Создано = 0;
	Пока Выборка.Следующий() Цикл

		Если НЕ ПлановаяОперацияСуществует(Выборка.Правило, Выборка.Дата) Тогда
			СоздатьПлановуюОперацию(Выборка, Выборка.Дата);
			Создано = Создано + 1;
		КонецЕсли;

	КонецЦикла;

	Возврат Создано;

КонецФункции

Функция ПлановаяОперацияСуществует(Правило, Дата)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПлановаяОперация.Ссылка
	|ИЗ
	|	Документ.ПлановаяОперация КАК ПлановаяОперация
	|ГДЕ
	|	ПлановаяОперация.Источник = &Правило
	|	И ПлановаяОперация.Дата = &Дата";
	Запрос.УстановитьПараметр("Правило", Правило);
	Запрос.УстановитьПараметр("Дата", Дата);
	Возврат НЕ Запрос.Выполнить().Пустой();
КонецФункции

Процедура СоздатьПлановуюОперацию(СтрокаПравила, Дата)
	Док = Документы.ПлановаяОперация.СоздатьДокумент();
	Док.Дата			= Дата;
	Док.Источник		= СтрокаПравила.Правило;
	Док.СтатьяДДС		= СтрокаПравила.СтатьяДДС;
	Док.Получатель		= СтрокаПравила.Получатель;
	Док.Валюта			= СтрокаПравила.Валюта;
	Док.Сумма			= СтрокаПравила.Сумма;
	Док.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

// Удаляет будущие (начиная с сегодня) документы ПлановаяОперация по Правилу,
// которые более не соответствуют его текущему расписанию — т.е. даты в
// Справочник.ПлановыеПравила.Расписание для этого правила больше нет,
// либо правило стало неактивным (тогда удаляются все будущие документы по
// нему). Прошедшие документы не трогает — это уже история. Вызывается после
// записи правила, перед повторной генерацией документов по обновлённому
// расписанию.
Процедура УдалитьНеактуальныеПлановыеОперации(Правило) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Правило", Правило);
	Запрос.УстановитьПараметр("НачалоСегодня", НачалоДня(ТекущаяДата()));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПлановаяОперация.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПлановаяОперация КАК ПлановаяОперация
	|ГДЕ
	|	ПлановаяОперация.Источник = &Правило
	|	И ПлановаяОперация.Дата >= &НачалоСегодня
	|	И НЕ ПлановаяОперация.Дата В
	|		(ВЫБРАТЬ
	|			Расписание.Дата
	|		ИЗ
	|			Справочник.ПлановыеПравила.Расписание КАК Расписание
	|		ГДЕ
	|			Расписание.Ссылка = &Правило
	|			И Расписание.Ссылка.Активно = ИСТИНА)";
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Выборка.Ссылка.ПолучитьОбъект().Удалить();
	КонецЦикла;

КонецПроцедуры

// Текущий суммарный остаток по всем кошелькам/счетам в основной валюте
// (РегистрНакопления.Оборот.Остатки без отбора) — используется как точка
// отсчёта остатка в платёжном календаре.
Функция ТекущийОстатокНаВсехКошельках()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(ОборотОстатки.СуммаВОсновнойВалютеОстаток) КАК Остаток
	|ИЗ
	|	РегистрНакопления.Оборот.Остатки КАК ОборотОстатки";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.Остаток <> NULL Тогда
		Возврат Выборка.Остаток;
	КонецЕсли;
	Возврат 0;
КонецФункции

// Заполняет платёжный календарь за период [ДатаНачала; ДатаОкончания]:
// ТаблицаОпераций — проведённые документы ПлановаяОперация по датам, с
// накопительным остатком (начиная с текущего фактического остатка по всем
// кошелькам); ТаблицаПоСтатьям — сгруппированная по статьям ДДС сумма за тот
// же период, чтобы видеть структуру доходов/расходов. Оба параметра —
// табличные реквизиты формы, заполняются напрямую (передаются по ссылке).
Процедура ЗаполнитьПлатежныйКалендарь(ДатаНачала, ДатаОкончания, ТаблицаОпераций, ТаблицаПоСтатьям) Экспорт

	ТаблицаОпераций.Очистить();
	ТаблицаПоСтатьям.Очистить();

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПлановаяОперация.Дата КАК Дата,
	|	ПлановаяОперация.СтатьяДДС КАК СтатьяДДС,
	|	ПлановаяОперация.СтатьяДДС.Тип КАК Тип,
	|	ПлановаяОперация.Получатель КАК Получатель,
	|	ПлановаяОперация.СуммаВОсновнойВалюте КАК Сумма
	|ПОМЕСТИТЬ втОперации
	|ИЗ
	|	Документ.ПлановаяОперация КАК ПлановаяОперация
	|ГДЕ
	|	ПлановаяОперация.Проведен = ИСТИНА
	|	И ПлановаяОперация.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втОперации.Дата КАК Дата,
	|	втОперации.СтатьяДДС КАК СтатьяДДС,
	|	втОперации.Тип КАК Тип,
	|	втОперации.Получатель КАК Получатель,
	|	втОперации.Сумма КАК Сумма
	|ИЗ
	|	втОперации КАК втОперации
	|УПОРЯДОЧИТЬ ПО
	|	Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втОперации.СтатьяДДС КАК СтатьяДДС,
	|	втОперации.Тип КАК Тип,
	|	СУММА(втОперации.Сумма) КАК Сумма
	|ИЗ
	|	втОперации КАК втОперации
	|СГРУППИРОВАТЬ ПО
	|	втОперации.СтатьяДДС,
	|	втОперации.Тип
	|УПОРЯДОЧИТЬ ПО
	|	Тип,
	|	Сумма УБЫВ";
	РезультатыПакета = Запрос.ВыполнитьПакет();

	Остаток = ТекущийОстатокНаВсехКошельках();
	ВыборкаОпераций = РезультатыПакета[1].Выбрать();
	Пока ВыборкаОпераций.Следующий() Цикл
		Стр = ТаблицаОпераций.Добавить();
		Стр.Дата		= ВыборкаОпераций.Дата;
		Стр.СтатьяДДС	= ВыборкаОпераций.СтатьяДДС;
		Стр.Получатель	= ВыборкаОпераций.Получатель;
		Если ВыборкаОпераций.Тип = Перечисления.ПриходРасход.Приход Тогда
			Стр.Приход = ВыборкаОпераций.Сумма;
			Остаток = Остаток + ВыборкаОпераций.Сумма;
		Иначе
			Стр.Расход = ВыборкаОпераций.Сумма;
			Остаток = Остаток - ВыборкаОпераций.Сумма;
		КонецЕсли;
		Стр.Остаток = Остаток;
	КонецЦикла;

	ВыборкаПоСтатьям = РезультатыПакета[2].Выбрать();
	Пока ВыборкаПоСтатьям.Следующий() Цикл
		Стр = ТаблицаПоСтатьям.Добавить();
		Стр.СтатьяДДС	= ВыборкаПоСтатьям.СтатьяДДС;
		Стр.Тип			= ВыборкаПоСтатьям.Тип;
		Стр.Сумма		= ВыборкаПоСтатьям.Сумма;
	КонецЦикла;

КонецПроцедуры

// Настраивает пунктирную линию серии диаграммы без маркеров — общий стиль плановых/справочных линий.
Процедура НастроитьПунктирнуюСерию(Серия, Цвет) Экспорт
	Серия.Линия	= Новый Линия(ТипЛинииДиаграммы.Пунктир, 2);
	Серия.Маркер	= ТипМаркераДиаграммы.Нет;
	Серия.Цвет		= Цвет;
КонецПроцедуры

Процедура ЗаполнитьДиаграммуЖизненныйПусть(Пользователь, Диаграмма) Экспорт

	Диаграмма.Очистить();

	Диаграмма.УстановитьПолныйИнтервал(Пользователь.ДатаРождения, Пользователь.ДатаДожития);

	ПоследнийДР = ПоследнийДеньРождения(Пользователь.ДатаРождения, ТекущаяДата());
	КолВоЛет = Год(ПоследнийДР) - Год(Пользователь.ДатаРождения);

	Точка	= Диаграмма.УстановитьТочку("_");
	Серия	= Диаграмма.УстановитьСерию("Пройденный жизненный путь");

	Значение = Диаграмма.ПолучитьЗначение(Точка, Серия);
	Интервал = Значение.Добавить();
	Интервал.Начало	= Пользователь.ДатаРождения;
	Интервал.Конец		= ТекущаяДата();
	Интервал.Текст		= "Пройденный жизненный путь: " + Формат(КолВоЛет, "ЧДЦ=0");

	Серия = Диаграмма.УстановитьСерию("Период");

	ПоследнийДР = ПоследнийДеньРождения(Пользователь.ДатаРождения, Пользователь.ДатаНачалаАктивногоИнвестирования);
	КолВоЛетБезИнвестирования = Год(ПоследнийДР) - Год(Пользователь.ДатаРождения);

	ПоследнийДР = ПоследнийДеньРождения(Пользователь.ДатаРождения, Пользователь.ДатаПереходаНаПассивныйДоход);
	КолВоЛетИнвестирования = Год(ПоследнийДР) - Год(Пользователь.ДатаРождения) - КолВоЛетБезИнвестирования;

	ПоследнийДР = ПоследнийДеньРождения(Пользователь.ДатаРождения, Пользователь.ДатаДожития);
	КолВоЛетПассивногоДохода = Год(ПоследнийДР) - Год(Пользователь.ДатаРождения) - КолВоЛетБезИнвестирования - КолВоЛетИнвестирования;

	Значение = Диаграмма.ПолучитьЗначение(Точка, Серия);
	Интервал = Значение.Добавить();
	Интервал.Начало		= Пользователь.ДатаРождения;
	Интервал.Конец			= Пользователь.ДатаНачалаАктивногоИнвестирования;
	Интервал.Текст			= "Период без инвестирования: " + Формат(КолВоЛетБезИнвестирования, "ЧДЦ=0");
	Интервал.Расшифровка	= Формат(Пользователь.ДатаРождения, "ДФ=dd.MM.yyyy") + " - " + Формат(Пользователь.ДатаНачалаАктивногоИнвестирования, "ДФ=dd.MM.yyyy");
	Интервал.Цвет			= WebЦвета.Красный;

	Значение = Диаграмма.ПолучитьЗначение(Точка, Серия);
	Интервал = Значение.Добавить();
	Интервал.Начало		= Пользователь.ДатаНачалаАктивногоИнвестирования;
	Интервал.Конец			= Пользователь.ДатаПереходаНаПассивныйДоход;
	Интервал.Текст			= "Период активного инвестирования: " + Формат(КолВоЛетИнвестирования, "ЧДЦ=0");
	Интервал.Расшифровка	= Формат(Пользователь.ДатаНачалаАктивногоИнвестирования, "ДФ=dd.MM.yyyy") + " - " + Формат(Пользователь.ДатаПереходаНаПассивныйДоход, "ДФ=dd.MM.yyyy");
	Интервал.Цвет			= WebЦвета.Оранжевый;

	Значение = Диаграмма.ПолучитьЗначение(Точка, Серия);
	Интервал = Значение.Добавить();
	Интервал.Начало		= Пользователь.ДатаПереходаНаПассивныйДоход;
	Интервал.Конец			= Пользователь.ДатаДожития;
	Интервал.Текст			= "Пассивный доход: " + Формат(КолВоЛетПассивногоДохода, "ЧДЦ=0");
	Интервал.Расшифровка	= Формат(Пользователь.ДатаПереходаНаПассивныйДоход, "ДФ=dd.MM.yyyy") + " - " + Формат(Пользователь.ДатаДожития, "ДФ=dd.MM.yyyy");
	Интервал.Цвет			= WebЦвета.ЗеленаяЛужайка;

КонецПроцедуры

Процедура ЗаполнитьДиаграммуЦели(Диаграмма) Экспорт

	Диаграмма.Очистить();

	СерияПлан = Диаграмма.Серии.Добавить("План");
	СерияФакт = Диаграмма.Серии.Добавить("Факт");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цели.Ссылка КАК Цель,
	|	Цели.СуммаСИнфляцией КАК СуммаПлан
	|ПОМЕСТИТЬ втЦели
	|ИЗ
	|	Справочник.Цели КАК Цели
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОборотОстатки.Цель КАК Цель,
	|	СУММА(ОборотОстатки.СуммаВОсновнойВалютеОстаток) КАК СуммаФакт
	|ПОМЕСТИТЬ втБаланс
	|ИЗ
	|	РегистрНакопления.Оборот.Остатки КАК ОборотОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ОборотОстатки.Цель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втЦели.Цель КАК Цель,
	|	втЦели.СуммаПлан КАК СуммаПлан,
	|	ЕСТЬNULL(втБаланс.СуммаФакт, 0) КАК СуммаФакт
	|ИЗ
	|	втЦели КАК втЦели
	|		ЛЕВОЕ СОЕДИНЕНИЕ втБаланс КАК втБаланс
	|		ПО втЦели.Цель = втБаланс.Цель
	|
	|УПОРЯДОЧИТЬ ПО
	|	СуммаПлан УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Точка = Диаграмма.УстановитьТочку(Выборка.Цель);
		Диаграмма.УстановитьЗначение(Точка, СерияФакт, Выборка.СуммаФакт, , Выборка.СуммаФакт);
		Диаграмма.УстановитьЗначение(Точка, СерияПлан, Выборка.СуммаПлан, , Выборка.СуммаПлан);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьДиаграммуДостиженияЦелей(Диаграмма) Экспорт

	Диаграмма.Очистить();

	СерияЦель = Диаграмма.Серии.Добавить("Цель (сумма)");
	НастроитьПунктирнуюСерию(СерияЦель, WebЦвета.Оранжевый);

	СерияПлан = Диаграмма.Серии.Добавить("План (сумма)");
	НастроитьПунктирнуюСерию(СерияПлан, WebЦвета.Красный);

	СерияФакт = Диаграмма.Серии.Добавить("Факт (сумма)");
	НастроитьПунктирнуюСерию(СерияФакт, WebЦвета.Зеленый);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ДостижениеЦелей.Период КАК Период,
		|	СУММА(ДостижениеЦелей.Сумма) КАК СуммаЦель,
		|	0 КАК СуммаПлан
		|ПОМЕСТИТЬ втЦели
		|ИЗ
		|	РегистрСведений.ДостижениеЦелей КАК ДостижениеЦелей
		|
		|СГРУППИРОВАТЬ ПО
		|	ДостижениеЦелей.Период
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(ДоходностьПоИнвестициям.Период, МЕСЯЦ),
		|	0,
		|	СУММА(ДоходностьПоИнвестициям.Пополнение + ДоходностьПоИнвестициям.Проценты)
		|ИЗ
		|	РегистрСведений.ДоходностьПоИнвестициям КАК ДоходностьПоИнвестициям
		|
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(ДоходностьПоИнвестициям.Период, МЕСЯЦ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(Календарь.ДатаКалендаря, МЕСЯЦ) КАК Период
		|ПОМЕСТИТЬ втКалендарь
		|ИЗ
		|	РегистрСведений.Календарь КАК Календарь
		|
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(Календарь.ДатаКалендаря, МЕСЯЦ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втЦели.Период КАК Период,
		|	СУММА(втЦели.СуммаЦель) КАК СуммаЦель,
		|	СУММА(втЦели.СуммаПлан) КАК СуммаПлан
		|ПОМЕСТИТЬ втЦели2
		|ИЗ
		|	втЦели КАК втЦели
		|
		|СГРУППИРОВАТЬ ПО
		|	втЦели.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОборотОстаткиИОбороты.Период КАК Период,
		|	ОборотОстаткиИОбороты.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток,
		|	ОборотОстаткиИОбороты.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток,
		|	ОборотОстаткиИОбороты.СуммаВОсновнойВалютеОборот КАК СуммаОборот,
		|	ОборотОстаткиИОбороты.СуммаПриход КАК СуммаПриход,
		|	ОборотОстаткиИОбороты.СуммаРасход КАК СуммаРасход
		|ПОМЕСТИТЬ втФакт
		|ИЗ
		|	РегистрНакопления.Оборот.ОстаткиИОбороты(, , Месяц, , ) КАК ОборотОстаткиИОбороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втКалендарь.Период КАК Период,
		|	ЕСТЬNULL(втЦели2.СуммаЦель, 0) КАК СуммаЦель,
		|	ЕСТЬNULL(втЦели2.СуммаПлан, 0) КАК СуммаПлан,
		|	ЕСТЬNULL(втФакт.СуммаОборот, 0) КАК СуммаФакт
		|ИЗ
		|	втКалендарь КАК втКалендарь
		|		ЛЕВОЕ СОЕДИНЕНИЕ втЦели2 КАК втЦели2
		|		ПО втКалендарь.Период = втЦели2.Период
		|		ЛЕВОЕ СОЕДИНЕНИЕ втФакт КАК втФакт
		|		ПО втКалендарь.Период = втФакт.Период
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период";
	Выборка = Запрос.Выполнить().Выбрать();
	СуммаЦельНакопительно = 0;
	СуммаПланНакопительно = 0;
	СуммаФактНакопительно = 0;
	Пока Выборка.Следующий() Цикл
		СуммаЦельНакопительно = СуммаЦельНакопительно + Выборка.СуммаЦель;
		СуммаПланНакопительно = СуммаПланНакопительно + Выборка.СуммаПлан;
		СуммаФактНакопительно = СуммаФактНакопительно + Выборка.СуммаФакт;
		Точка = Диаграмма.УстановитьТочку(Формат(Выборка.Период, "ДФ=ММ.гггг"));
		Диаграмма.УстановитьЗначение(Точка, СерияЦель, СуммаЦельНакопительно, , СуммаЦельНакопительно);
		Диаграмма.УстановитьЗначение(Точка, СерияПлан, СуммаПланНакопительно, , СуммаПланНакопительно);
		Диаграмма.УстановитьЗначение(Точка, СерияФакт, СуммаФактНакопительно, , СуммаФактНакопительно);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьДиаграммуДоходыРасходы(Диаграмма) Экспорт

	Диаграмма.Очистить();

	СерияРасход = Диаграмма.Серии.Добавить("Расходы (план)");
	НастроитьПунктирнуюСерию(СерияРасход, WebЦвета.Оранжевый);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(Календарь.ДатаКалендаря, МЕСЯЦ) КАК Период
		|ПОМЕСТИТЬ втКалендарь
		|ИЗ
		|	РегистрСведений.Календарь КАК Календарь
		|
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(Календарь.ДатаКалендаря, МЕСЯЦ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(ПлановыеДвижения.Период, МЕСЯЦ) КАК Период,
		|	СУММА(ПлановыеДвижения.СуммаВОсновнойВалюте) КАК Расход
		|ПОМЕСТИТЬ втРасходы
		|ИЗ
		|	РегистрНакопления.ПлановыеДвижения КАК ПлановыеДвижения
		|ГДЕ
		|	ПлановыеДвижения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(ПлановыеДвижения.Период, МЕСЯЦ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втКалендарь.Период КАК Период,
		|	ЕСТЬNULL(втРасходы.Расход, 0) КАК Расход
		|ИЗ
		|	втКалендарь КАК втКалендарь
		|		ЛЕВОЕ СОЕДИНЕНИЕ втРасходы КАК втРасходы
		|		ПО втКалендарь.Период = втРасходы.Период
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Точка = Диаграмма.УстановитьТочку(Формат(Выборка.Период, "ДФ=ММ.гггг"));
		Диаграмма.УстановитьЗначение(Точка, СерияРасход, Выборка.Расход, , Выборка.Расход);
	КонецЦикла;

КонецПроцедуры
