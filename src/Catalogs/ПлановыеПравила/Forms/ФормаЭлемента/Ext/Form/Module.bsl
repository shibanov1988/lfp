&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОбновитьОписаниеРасписания();
КонецПроцедуры

&НаКлиенте
Процедура НастроитьРасписание(Команда)
	Оповещение = Новый ОписаниеОповещения("ПослеНастройкиРасписания", ЭтаФорма);
	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(ТекущееРасписаниеНаСервере());
	Диалог.Показать(Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ПослеНастройкиРасписания(Расписание, ДопПараметры) Экспорт
	Если Расписание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СохранитьРасписаниеНаСервере(Расписание);
КонецПроцедуры

&НаСервере
Функция ТекущееРасписаниеНаСервере()
	Расписание = Объект.Расписание.Получить();
	Если Расписание = Неопределено Тогда
		Расписание = Новый РасписаниеРегламентногоЗадания;
		Расписание.ДатаНачала = НачалоДня(ТекущаяДата());
	КонецЕсли;
	Возврат Расписание;
КонецФункции

&НаСервере
Процедура СохранитьРасписаниеНаСервере(Расписание)
	Объект.Расписание = Новый ХранилищеЗначения(Расписание);
	ОбновитьОписаниеРасписания();
КонецПроцедуры

&НаСервере
Процедура ОбновитьОписаниеРасписания()
	Расписание = Объект.Расписание.Получить();
	Если Расписание = Неопределено Тогда
		ОписаниеРасписания = "не задано";
	Иначе
		Если ЗначениеЗаполнено(Расписание.ДатаКонца) Тогда
			ОписаниеРасписания = "с " + Формат(Расписание.ДатаНачала, "ДФ=dd.MM.yyyy")
				+ " по " + Формат(Расписание.ДатаКонца, "ДФ=dd.MM.yyyy");
		Иначе
			ОписаниеРасписания = "с " + Формат(Расписание.ДатаНачала, "ДФ=dd.MM.yyyy") + ", бессрочно";
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
