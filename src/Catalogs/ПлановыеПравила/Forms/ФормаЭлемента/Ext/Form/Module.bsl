&НаКлиенте
Процедура НастроитьРасписание(Команда)
	Оповещение = Новый ОписаниеОповещения("ПослеНастройкиРасписания", ЭтаФорма);
	Расписание = Новый РасписаниеРегламентногоЗадания;
	Расписание.ДатаНачала = НачалоДня(ТекущаяДата());
	ГраницаПоУмолчанию = ГраницаПланированияПоУмолчаниюНаСервере();
	Если ГраницаПоУмолчанию <> Неопределено Тогда
		Расписание.ДатаКонца = ГраницаПоУмолчанию;
	КонецЕсли;
	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(Расписание);
	Диалог.Показать(Оповещение);
КонецПроцедуры

// Дата дожития пользователя — чтобы диалог расписания сразу показывал её
// как дату окончания, а не только использовал внутри как запасное
// ограничение при материализации.
&НаСервере
Функция ГраницаПланированияПоУмолчаниюНаСервере()
	Возврат ЛФПСервер.ГраницаПланированияПоУмолчанию();
КонецФункции

&НаКлиенте
Процедура ПослеНастройкиРасписания(Расписание, ДопПараметры) Экспорт
	Если Расписание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьРасписаниеНаСервере(Расписание);
КонецПроцедуры

// Считает даты, на которые сработало бы расписание (Расписание.ТребуетсяВыполнение —
// тот же метод, что используют регламентные задания), и кладёт их в табличную часть
// Объект.Расписание. По умолчанию горизонт — дата дожития текущего пользователя
// (или 10 лет вперёд, если она не задана), либо дата окончания расписания, если
// она раньше — дальше нет смысла материализовывать заранее, можно перенастроить
// расписание позже.
&НаСервере
Процедура ЗаполнитьРасписаниеНаСервере(Расписание)

	Объект.Расписание.Очистить();

	Если НЕ ЗначениеЗаполнено(Расписание.ДатаНачала) Тогда
		Возврат;
	КонецЕсли;

	ГраницаМатериализации = ЛФПСервер.ГраницаПланированияПоУмолчанию();
	Если ГраницаМатериализации = Неопределено Тогда
		ГраницаМатериализации = ДобавитьМесяц(ТекущаяДата(), 120);
	КонецЕсли;
	Если ЗначениеЗаполнено(Расписание.ДатаКонца) И Расписание.ДатаКонца < ГраницаМатериализации Тогда
		ГраницаМатериализации = Расписание.ДатаКонца;
	КонецЕсли;

	Дата = НачалоДня(Расписание.ДатаНачала);
	ДатаПоследнегоЗапуска = Дата - 86400;

	Пока Дата <= ГраницаМатериализации Цикл

		Если Расписание.ТребуетсяВыполнение(Дата, ДатаПоследнегоЗапуска) Тогда
			Стр = Объект.Расписание.Добавить();
			Стр.Дата = Дата;
			ДатаПоследнегоЗапуска = Дата;
		КонецЕсли;

		Дата = Дата + 86400;

	КонецЦикла;

КонецПроцедуры

// Сразу после записи правила подчищает будущие документы, переставшие
// соответствовать текущему расписанию (или всё расписание целиком, если
// правило деактивировано), и создаёт недостающие плановые операции по
// актуальному расписанию — отдельный шаг "Создание плановых операций" для
// этого не нужен, он остаётся как утилита для ручной досборки (например,
// после смены даты дожития).
&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	ЛФПСервер.УдалитьНеактуальныеПлановыеОперации(ТекущийОбъект.Ссылка);
	Горизонт = ЛФПСервер.ГраницаПланированияПоУмолчанию();
	Если Горизонт = Неопределено Тогда
		Горизонт = ДобавитьМесяц(ТекущаяДата(), 120);
	КонецЕсли;
	ЛФПСервер.СгенерироватьПлановыеОперации(Горизонт);
КонецПроцедуры
