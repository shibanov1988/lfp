&НаКлиенте
Процедура НастроитьРасписание(Команда)
	Оповещение = Новый ОписаниеОповещения("ПослеНастройкиРасписания", ЭтаФорма);
	Расписание = Новый РасписаниеРегламентногоЗадания;
	Расписание.ДатаНачала = НачалоДня(ТекущаяДата());
	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(Расписание);
	Диалог.Показать(Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ПослеНастройкиРасписания(Расписание, ДопПараметры) Экспорт
	Если Расписание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьРасписаниеНаСервере(Расписание);
КонецПроцедуры

// Считает даты, на которые сработало бы расписание (Расписание.ТребуетсяВыполнение —
// тот же метод, что используют регламентные задания), и кладёт их в табличную часть
// Объект.Расписание. Ограничивает горизонт 10 годами вперёд (или датой окончания
// расписания, если она раньше) — дальше нет смысла материализовывать заранее,
// можно перенастроить расписание позже.
&НаСервере
Процедура ЗаполнитьРасписаниеНаСервере(Расписание)

	Объект.Расписание.Очистить();

	Если НЕ ЗначениеЗаполнено(Расписание.ДатаНачала) Тогда
		Возврат;
	КонецЕсли;

	ГраницаМатериализации = ДобавитьМесяц(ТекущаяДата(), 120);
	Если ЗначениеЗаполнено(Расписание.ДатаКонца) И Расписание.ДатаКонца < ГраницаМатериализации Тогда
		ГраницаМатериализации = Расписание.ДатаКонца;
	КонецЕсли;

	Дата = НачалоДня(Расписание.ДатаНачала);
	ДатаПоследнегоЗапуска = Дата - 86400;

	Пока Дата <= ГраницаМатериализации Цикл

		Если Расписание.ТребуетсяВыполнение(Дата, ДатаПоследнегоЗапуска) Тогда
			Стр = Объект.Расписание.Добавить();
			Стр.Дата = Дата;
			ДатаПоследнегоЗапуска = Дата;
		КонецЕсли;

		Дата = Дата + 86400;

	КонецЦикла;

КонецПроцедуры
